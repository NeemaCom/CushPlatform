# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database
# Dedicated production/staging Supabase connection for Cush Verify only.
CUSH_VERIFY_DATABASE_URL=

# Session Configuration
# Set SESSION_SECRET as a private environment variable (unique random value, at least 32 characters).
SESSION_SECRET=
# Separate secret for the isolated Cush Verify session cookie/store.
CUSH_VERIFY_SESSION_SECRET=
# Passport Firebase server settings. For staging, use credentials from the
# dedicated Passport staging Firebase project; do not reuse production credentials.
FIREBASE_PROJECT_ID=cushportal
FIREBASE_API_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Browser build-time overrides. Leave all four core values blank to retain the
# existing production defaults; for staging, set all four from its web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional Firebase web app fields.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Set to "verify" only on the staging frontend to open Cush Verify at `/`.
VITE_DEFAULT_APP=
# Cush Verify institutional authentication is intentionally isolated from the
# Passport Firebase project. Configure these from the dedicated Firebase project.
CUSH_VERIFY_FIREBASE_PROJECT_ID=
CUSH_VERIFY_FIREBASE_CLIENT_EMAIL=
CUSH_VERIFY_FIREBASE_PRIVATE_KEY=
CUSH_VERIFY_APP_URL=
CUSH_PASSPORT_APP_URL=
# Base64-encoded 32-byte AES-256 key for Passport financial profiles and evidence.
# Generate independently for each environment and store as a private secret.
PASSPORT_EVIDENCE_ENCRYPTION_KEY=
VITE_CUSH_VERIFY_FIREBASE_API_KEY=
VITE_CUSH_VERIFY_FIREBASE_AUTH_DOMAIN=
VITE_CUSH_VERIFY_FIREBASE_PROJECT_ID=
VITE_CUSH_VERIFY_FIREBASE_APP_ID=

# Environment (npm run dev sets development; npm run start sets production)
NODE_ENV=development

# Server Configuration
PORT=5000
HOST=0.0.0.0
# Mono uses the same API host for sandbox and live; NODE_ENV selects which key is used.
# Development/test reads MONO_SANDBOX_SECRET_KEY. Production reads MONO_LIVE_SECRET_KEY only.
MONO_SANDBOX_SECRET_KEY=
MONO_LIVE_SECRET_KEY=
# Absolute URL of the frontend dashboard that receives Mono's connection code.
MONO_REDIRECT_URL=
# Node API deployment: set this to your Vercel frontend origin (e.g. https://your-app.vercel.app).
# Use comma-separated origins for multiple frontends, without trailing slashes.
# Development also allows localhost:3000 and localhost:5000 by default.
FRONTEND_ORIGIN=
# Production always sends Secure; SameSite=None cookies. Set "none" here only if
# developing with a cross-site frontend and HTTPS; otherwise development uses Strict.
SESSION_COOKIE_SAME_SITE=strict

# Vercel frontend deployment: set at build time to the Node API origin
# (e.g. https://api.example.com, no /api suffix). Empty means same-origin /api requests.
VITE_API_URL=
# Required in production only for generating referral links
APP_URL=
