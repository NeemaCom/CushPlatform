# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database

# Session Configuration
# Set SESSION_SECRET as a private environment variable (unique random value, at least 32 characters).
SESSION_SECRET=
FIREBASE_PROJECT_ID=cushportal

# Environment (npm run dev sets development; npm run start sets production)
NODE_ENV=development

# Server Configuration
PORT=5000
HOST=0.0.0.0
# Comma-separated frontend origins allowed to send credentialed cross-origin API requests.
# Defaults to localhost:3000 and localhost:5000 during development; unset for same-origin production.
FRONTEND_ORIGIN=
# Use "none" only when the browser frontend and API are on different sites (requires HTTPS).
SESSION_COOKIE_SAME_SITE=strict

# Frontend (empty means same-origin /api requests)
VITE_API_URL=
# Required in production only for generating referral links
APP_URL=
