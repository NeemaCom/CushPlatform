# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database

# Session Configuration
# Set SESSION_SECRET as a private environment variable (unique random value, at least 32 characters).
SESSION_SECRET=
FIREBASE_PROJECT_ID=cushportal

# Environment (npm run dev sets development; npm run start sets production)
NODE_ENV=development

# Server Configuration
PORT=5000
HOST=0.0.0.0
# Node API deployment: set this to your Vercel frontend origin (e.g. https://your-app.vercel.app).
# Use comma-separated origins for multiple frontends, without trailing slashes.
# Development also allows localhost:3000 and localhost:5000 by default.
FRONTEND_ORIGIN=
# Production always sends Secure; SameSite=None cookies. Set "none" here only if
# developing with a cross-site frontend and HTTPS; otherwise development uses Strict.
SESSION_COOKIE_SAME_SITE=strict

# Vercel frontend deployment: set at build time to the Node API origin
# (e.g. https://api.example.com, no /api suffix). Empty means same-origin /api requests.
VITE_API_URL=
# Required in production only for generating referral links
APP_URL=
