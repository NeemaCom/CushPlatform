run = "npm run dev"
modules = ["nodejs-24"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 20719
externalPort = 3001

[[ports]]
localPort = 21702
externalPort = 3002

[[ports]]
localPort = 24678
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Start application"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[nix]
channel = "stable-25_05"
